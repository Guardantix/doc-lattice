# doc-lattice-managed: github-ci-v1
# doc-lattice-artifact: offline
# doc-lattice-version: 2.1.0
# doc-lattice-repository: Guardantix/doc-lattice
name: doc-lattice
on:
  push:
    branches: [main]
  pull_request:
    branches: [main]
permissions:
  contents: read
jobs:
  check:
    name: Offline doc-lattice gates
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
      - uses: astral-sh/setup-uv@d0cc045d04ccac9d8b7881df0226f9e82c39688e # v6.8.0
        with:
          enable-cache: false
      - name: Audit, check, and lint
        run: |
          set +e
          uvx --python 3.13 --from doc-lattice==2.1.0 doc-lattice ci audit --repository Guardantix/doc-lattice
          rc_audit=$?
          uvx --python 3.13 --from doc-lattice==2.1.0 doc-lattice check
          rc_check=$?
          uvx --python 3.13 --from doc-lattice==2.1.0 doc-lattice lint
          rc_lint=$?
          [ "$rc_audit" -eq 0 ] && [ "$rc_check" -eq 0 ] && [ "$rc_lint" -eq 0 ]
